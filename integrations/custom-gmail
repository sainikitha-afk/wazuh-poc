#!/usr/bin/env python3
import sys
import json
import smtplib
import ssl
from email.mime.text import MIMEText

# Credentials are never hardcoded in the committed version -
# on the real deployment these are filled in locally and this
# file is never re-copied back out of the server with real values.
SENDER_EMAIL = "YOUR_GMAIL_ADDRESS_HERE"
APP_PASSWORD = "YOUR_16_CHAR_APP_PASSWORD_HERE"
RECIPIENT_EMAIL = "YOUR_GMAIL_ADDRESS_HERE"

def main():
    alert_file = sys.argv[1]
    with open(alert_file) as f:
        alert = json.load(f)

    rule = alert.get("rule", {})
    description = rule.get("description", "Wazuh Alert")
    level = rule.get("level", "N/A")
    agent = alert.get("agent", {}).get("name", "unknown")
    full_log = alert.get("full_log", "")

    subject = f"[Wazuh Alert] Level {level}: {description}"
    body = (
        f"Description: {description}\n"
        f"Level: {level}\n"
        f"Agent: {agent}\n"
        f"Raw log: {full_log}\n"
    )

    msg = MIMEText(body)
    msg["Subject"] = subject
    msg["From"] = SENDER_EMAIL
    msg["To"] = RECIPIENT_EMAIL

    context = ssl.create_default_context()
    with smtplib.SMTP("smtp.gmail.com", 587) as server:
        server.starttls(context=context)
        server.login(SENDER_EMAIL, APP_PASSWORD)
        server.send_message(msg)

if __name__ == "__main__":
    main()
